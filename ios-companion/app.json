{
  "expo": {
    "name": "Stephen's To-Do",
    "slug": "stephens-todo-ios",
    "version": "1.7.8",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "stephenstodo",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stephendeblanche.stephenstodo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationUsageDescription": "Stephen’s To-Do uses notifications for urgent and due-task reminders."
      }
    },
    "plugins": ["expo-notifications"],
    "extra": {
      "eas": {
        "projectId": "d24a5c3f-a713-4f4d-9902-8c85325d8413"
      }
    }
  }
}
